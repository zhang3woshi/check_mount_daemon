#!/bin/bash

set -eu

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
BIN_FILE="${TRIM_APPDEST}/bin/check_mount_daemon"
CONFIG_FILE="${TRIM_PKGETC}/config.json"

log_msg() {
    mkdir -p "${TRIM_PKGVAR}"
    printf "%s - %s\n" "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${LOG_FILE}"
}

check_process() {
    local pid="$1"
    [ -n "${pid}" ] || return 1
    kill -0 "${pid}" 2>/dev/null || return 1
    [ -r "/proc/${pid}/exe" ] || return 1
    [ "$(readlink -f "/proc/${pid}/exe")" = "${BIN_FILE}" ]
}

read_pid() {
    if [ -r "${PID_FILE}" ]; then
        head -n 1 "${PID_FILE}" | tr -d '[:space:]'
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid="$(read_pid)"
        if check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    return 1
}

ensure_runtime_files() {
    mkdir -p "${TRIM_PKGETC}" "${TRIM_PKGVAR}"

    if [ ! -x "${BIN_FILE}" ]; then
        log_msg "Binary not found: ${BIN_FILE}"
        return 1
    fi

    if [ ! -f "${CONFIG_FILE}" ]; then
        cp "${TRIM_APPDEST}/defaults/config.json" "${CONFIG_FILE}"
        log_msg "Created default config: ${CONFIG_FILE}"
    fi

    touch "${LOG_FILE}"
    chmod 0600 "${LOG_FILE}"
    log_msg "Runtime paths: appdest=${TRIM_APPDEST}, pkgetc=${TRIM_PKGETC}, pkgvar=${TRIM_PKGVAR}"
    log_msg "Binary path: ${BIN_FILE}"
    log_msg "Config path: ${CONFIG_FILE}"
    log_msg "Log path: ${LOG_FILE}"
    return 0
}

start_process() {
    if status; then
        log_msg "Process already running"
        return 0
    fi

    ensure_runtime_files || return 1

    log_msg "Starting process ..."
    CONFIG_PATH="${CONFIG_FILE}" WEB_PASSWORD_FILE="${TRIM_PKGVAR}/web_password" "${BIN_FILE}" >> "${LOG_FILE}" 2>&1 &
    pid="$!"
    printf "%s" "${pid}" > "${PID_FILE}"
    sleep 1

    if check_process "${pid}"; then
        log_msg "Started process, pid=${pid}"
        return 0
    fi

    log_msg "Failed to start process"
    rm -f "${PID_FILE}"
    return 1
}

stop_process() {
    if [ ! -r "${PID_FILE}" ]; then
        log_msg "Process is not running"
        return 0
    fi

    pid="$(read_pid)"
    if ! check_process "${pid}"; then
        rm -f "${PID_FILE}"
        log_msg "Removed stale pid file"
        return 0
    fi

    log_msg "Stopping process pid=${pid}"
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true

    count=0
    while check_process "${pid}" && [ "${count}" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "${pid}"; then
        log_msg "Process still alive, sending SIGKILL"
        kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1 || true
        sleep 1
    fi

    rm -f "${PID_FILE}"
    log_msg "Process stopped"
    return 0
}

case "${1:-}" in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 1
    ;;
esac
