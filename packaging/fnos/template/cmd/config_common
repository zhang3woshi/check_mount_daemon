#!/bin/bash

set -eu

CONFIG_FILE="${TRIM_PKGETC}/config.json"
DEFAULT_CONFIG="${TRIM_APPDEST}/defaults/config.json"

fail_config() {
    local message="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "${message}" > "${TRIM_TEMP_LOGFILE}"
    fi
    printf '%s\n' "${message}" >&2
    return 1
}

json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

validate_path() {
    local label="$1"
    local value="$2"
    case "${value}" in
        /*) ;;
        *) fail_config "${label} 必须是以 / 开头的绝对路径"; return 1 ;;
    esac
    case "${value}" in
        *'"'*|*'\\'*|*$'\n'*|*$'\r'*) fail_config "${label} 包含不支持的字符"; return 1 ;;
    esac
}

validate_check_file() {
    local value="$1"
    case "${value}" in
        ''|*[!A-Za-z0-9._-]*) fail_config "检查文件名只能包含字母、数字、点、下划线和短横线"; return 1 ;;
    esac
}

validate_interval() {
    local value="$1"
    case "${value}" in
        ''|*[!0-9]*) fail_config "检查间隔必须是数字"; return 1 ;;
    esac
    if [ "${value}" -lt 5 ] || [ "${value}" -gt 86400 ]; then
        fail_config "检查间隔必须在 5 到 86400 秒之间"
        return 1
    fi
}

write_web_password_if_present() {
    local password="${wizard_web_password:-}"
    if [ -z "${password}" ]; then
        return 0
    fi
    if [ "${#password}" -lt 16 ] || [ "${#password}" -gt 128 ] || [[ "${password}" == *$'\n'* ]] || [[ "${password}" == *$'\r'* ]]; then
        fail_config "网页管理密码长度必须为 16 到 128 个字符，且不能包含换行"
        return 1
    fi
    mkdir -p "${TRIM_PKGVAR}"
    local temporary_file="${TRIM_PKGVAR}/web_password.tmp.$$"
    (umask 077; printf '%s' "${password}" > "${temporary_file}")
    chmod 0600 "${temporary_file}"
    mv -f "${temporary_file}" "${TRIM_PKGVAR}/web_password"
}

append_mount() {
    local source="$1"
    local target="$2"
    local check_file="$3"

    if [ -z "${source}" ]; then
        return 0
    fi
    if [ -z "${target}" ]; then
        target="/vol1/1000/Photos"
    fi
    if [ -z "${check_file}" ]; then
        check_file="remote"
    fi

    validate_path "源目录" "${source}"
    validate_path "目标目录" "${target}"
    validate_check_file "${check_file}"

    if [ "${MOUNT_COUNT}" -gt 0 ]; then
        printf ',\n' >&3
    fi
    printf '    {"source":"%s","target":"%s","checkFile":"%s"}' \
        "$(json_escape "${source}")" "$(json_escape "${target}")" "$(json_escape "${check_file}")" >&3
    MOUNT_COUNT=$((MOUNT_COUNT + 1))
}

write_config_from_wizard() {
    local interval="${wizard_interval_seconds:-30}"
    validate_interval "${interval}"

    mkdir -p "${TRIM_PKGETC}"
    local temporary_file="${CONFIG_FILE}.tmp.$$"
    MOUNT_COUNT=0
    {
        printf '{\n  "mounts": [\n'
        # File descriptor 3 lets append_mount write JSON into the same atomic file.
    } > "${temporary_file}"
    exec 3>>"${temporary_file}"
    append_mount "${wizard_source_dir_1:-}" "${wizard_target_dir_1:-}" "${wizard_check_file_1:-}"
    append_mount "${wizard_source_dir_2:-}" "${wizard_target_dir_2:-}" "${wizard_check_file_2:-}"
    append_mount "${wizard_source_dir_3:-}" "${wizard_target_dir_3:-}" "${wizard_check_file_3:-}"
    exec 3>&-
    if [ "${MOUNT_COUNT}" -eq 0 ]; then
        rm -f "${temporary_file}"
        fail_config "至少需要配置一个挂载源目录"
        return 1
    fi
    printf '\n  ],\n  "intervalSeconds": %s\n}\n' "${interval}" >> "${temporary_file}"
    chmod 0640 "${temporary_file}"
    mv -f "${temporary_file}" "${CONFIG_FILE}"
}

apply_wizard_config_if_present() {
    if [ -n "${wizard_source_dir_1:-}" ] || [ -n "${wizard_source_dir_2:-}" ] || [ -n "${wizard_source_dir_3:-}" ]; then
        write_config_from_wizard
    elif [ ! -f "${CONFIG_FILE}" ]; then
        mkdir -p "${TRIM_PKGETC}"
        cp "${DEFAULT_CONFIG}" "${CONFIG_FILE}"
    fi
}
